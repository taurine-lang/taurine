let PI = math_pi()
let E = math_e()
let TAU = math_pi() * 2
let SQRT2 = math_sqrt(2)

function abs(x) {
    return math_abs(x)
}

function sign(x) {
    if x > 0 { return 1 }
    if x < 0 { return -1 }
    return 0
}

function floor(x) {
    return math_floor(x)
}

function ceil(x) {
    return math_ceil(x)
}

function round(x) {
    return math_round(x)
}

function clamp(x, min, max) {
    if x < min { return min }
    if x > max { return max }
    return x
}

function min(a, b) {
    if a < b { return a }
    return b
}

function max(a, b) {
    if a > b { return a }
    return b
}

function sqrt(x) {
    return math_sqrt(x)
}

function pow(base, exp) {
    return math_pow(base, exp)
}

function sin(x) {
    return math_sin(x)
}

function cos(x) {
    return math_cos(x)
}

function tan(x) {
    let c = cos(x)
    if c == 0 { throw "tan() undefined at this point" }
    return sin(x) / c
}

function deg2rad(deg) {
    return deg * PI / 180
}

function rad2deg(rad) {
    return rad * 180 / PI
}

function gcd(a, b) {
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return abs(a)
}

function lcm(a, b) {
    return abs(a * b) / gcd(a, b)
}

function factorial(n) {
    if n < 0 { throw "factorial() requires non-negative integer" }
    if n <= 1 { return 1 }
    let result = 1
    let i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

function isPrime(n) {
    if n < 2 { return false }
    if n == 2 { return true }
    if n % 2 == 0 { return false }
    let i = 3
    while i * i <= n {
        if n % i == 0 { return false }
        i = i + 2
    }
    return true
}

function fib(n) {
    if n <= 1 { return n }
    let a = 0
    let b = 1
    let i = 2
    while i <= n {
        let temp = a + b
        a = b
        b = temp
        i = i + 1
    }
    return b
}